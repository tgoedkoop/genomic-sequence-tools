# Load required library
# (Note: Requires ggplot2 to be installed via install.packages("ggplot2"))
library(ggplot2)

# 1. Create some dummy transcriptomic data
# We are simulating gene expression between Control and Treatment groups
gene_data <- data.frame(
  Gene = c("BRCA1", "BRCA1", "TP53", "TP53", "EGFR", "EGFR"),
  Condition = c("Control", "Treatment", "Control", "Treatment", "Control", "Treatment"),
  Expression_Level = c(12.5, 18.2, 8.4, 4.1, 15.1, 14.8)
)

print("Dummy data generated:")
print(gene_data)

# 2. Create a bar plot using ggplot2
expression_plot <- ggplot(gene_data, aes(x = Gene, y = Expression_Level, fill = Condition)) +
  geom_bar(stat = "identity", position = "dodge") +
  theme_minimal() +
  labs(
    title = "Gene Expression Analysis",
    x = "Target Gene",
    y = "Normalized Expression Level",
    fill = "Experimental Condition"
  )

# 3. Save the plot as an image file
ggsave("gene_expression_plot.png", plot = expression_plot, width = 6, height = 4)
print("Plot saved successfully as 'gene_expression_plot.png'")
